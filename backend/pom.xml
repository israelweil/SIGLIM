<?xml version="1.0" encoding="UTF-8"?>
<!--
  SIGLIM · Backend (API REST)
  Monolito modular por paquetes con Spring JDBC (ADR-0002, ADR-0006).
  Tareas: T-02.1, T-02.2, T-02.3 · Refs: RNF-019, ADR-0002, ADR-0006, ADR-0014

  Dependencias de esta tarea y por qué están:
  - webmvc:     API REST en /api/v1 (convenciones-api.md).
  - jdbc:       JdbcClient con SQL explícito; sin JPA ni ddl-auto (ADR-0002, ADR-0004).
  - postgresql: controlador JDBC para Supabase (solo en ejecución).
  - validation: Jakarta Validation de DTO y de la configuración (falla al arrancar si falta una variable).
  - actuator:   /actuator/health para el monitoreo (RNF-001, RNF-011).
  - security-oauth2-resource-server: valida el JWT de Supabase Auth con su JWKS (T-02.2, ADR-0003).
  Pruebas de integración con BD (T-02.3, decisión del equipo del 22 oct 2026): Testcontainers con
  PostgreSQL 17 (la versión de Supabase). Requieren Docker; sin Docker se omiten (*IT con failsafe).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>mx.tecnm.morelia</groupId>
    <artifactId>siglim</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>SIGLIM Backend</name>
    <description>API REST del Sistema de Gestión de la Liga Municipal de Futbol Amateur Morelia</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Pruebas: JUnit 5, AssertJ, Mockito y MockMvcTester (@WebMvcTest). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Pruebas de seguridad: firma de JWT de prueba con NimbusJwtEncoder y spring-security-test. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Pruebas de integración con PostgreSQL real en un contenedor (Testcontainers 2). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Ejecuta las pruebas *IT (integración) en `mvnw verify`, después de las unitarias. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

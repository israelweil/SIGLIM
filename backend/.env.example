# ─────────────────────────────────────────────────────────────────────────────────────────────
# Variables de entorno del backend de SIGLIM (T-02.1, RNF-019).
#
# Uso:  cp .env.example .env     (Windows: copy .env.example .env)  y llena los valores.
# backend/.env está en .gitignore: NUNCA lo subas ni pegues sus valores en un chat o una IA.
# Cada quien copia sus credenciales desde el panel de Supabase (Developer en la organización).
# Una prueba (VariablesEntornoDocumentadasTest) falla si application.yml usa una variable que no
# esté listada aquí.
# ─────────────────────────────────────────────────────────────────────────────────────────────

# ── Base de datos (ADR-0014) ─────────────────────────────────────────────────────────────────
# Supabase → Connect → JDBC → Transaction pooler (puerto 6543). Agrega al final:
#   currentSchema=siglim   → las tablas viven en el esquema siglim, no en public
#   prepareThreshold=0     → el pooler en modo transacción no admite sentencias preparadas
#                            del lado del servidor entre transacciones
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?currentSchema=siglim&prepareThreshold=0
# Usuario del pooler: postgres.<ref-del-proyecto>
DB_USERNAME=postgres.<ref-del-proyecto>
# Contraseña de la base de datos (Supabase → Project Settings → Database). Secreto.
DB_PASSWORD=

# ── Supabase Auth (ADR-0003) ─────────────────────────────────────────────────────────────────
# URL del proyecto, sin diagonal final. De aquí se derivan el emisor y el JWKS del JWT (T-02.2).
SUPABASE_URL=https://<ref-del-proyecto>.supabase.co

# ── CORS (convenciones de API §5) ────────────────────────────────────────────────────────────
# Orígenes exactos del frontend (esquema://host:puerto, sin ruta ni comodín), separados por coma.
SIGLIM_CORS_ORIGEN=http://localhost:5173

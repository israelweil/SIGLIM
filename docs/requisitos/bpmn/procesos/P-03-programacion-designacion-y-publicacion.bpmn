  <bpmn:collaboration id="Colaboracion_P03">
    <bpmn:documentation>P-03 Programación manual, designación y publicación. Registrar la jornada sin conflictos duros, designar árbitros, aprobarla y publicarla.</bpmn:documentation>
    <bpmn:participant id="Pool_P03" name="Liga Municipal de Futbol Amateur Morelia — SIGLIM" processRef="Proceso_P03"/>
  </bpmn:collaboration>
  <bpmn:process id="Proceso_P03" name="P-03 Programación manual, designación y publicación" isExecutable="false">
    <bpmn:laneSet id="Carriles_P03"><bpmn:lane id="Carril_pro" name="Programador de partidos"><bpmn:flowNodeRef>P03_i</bpmn:flowNodeRef><bpmn:flowNodeRef>P03_t1</bpmn:flowNodeRef><bpmn:flowNodeRef>P03_t2</bpmn:flowNodeRef><bpmn:flowNodeRef>P03_t3</bpmn:flowNodeRef><bpmn:flowNodeRef>P03_g2</bpmn:flowNodeRef><bpmn:flowNodeRef>P03_t4</bpmn:flowNodeRef><bpmn:flowNodeRef>P03_g3</bpmn:flowNodeRef><bpmn:flowNodeRef>P03_t5</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_car" name="Comisión de Arbitraje"><bpmn:flowNodeRef>P03_c1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_pre" name="Presidente del Comité Ejecutivo"><bpmn:flowNodeRef>P03_p1</bpmn:flowNodeRef><bpmn:flowNodeRef>P03_g4</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_sis" name="Sistema"><bpmn:flowNodeRef>P03_s1</bpmn:flowNodeRef><bpmn:flowNodeRef>P03_g1</bpmn:flowNodeRef><bpmn:flowNodeRef>P03_s2</bpmn:flowNodeRef><bpmn:flowNodeRef>P03_s3</bpmn:flowNodeRef><bpmn:flowNodeRef>P03_s4</bpmn:flowNodeRef><bpmn:flowNodeRef>P03_s5</bpmn:flowNodeRef><bpmn:flowNodeRef>P03_f1</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
        <bpmn:startEvent id="P03_i" name="Preparar jornada"><bpmn:outgoing>Flujo_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P03_t1" name="Crear jornada"><bpmn:incoming>Flujo_1</bpmn:incoming><bpmn:outgoing>Flujo_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P03_t2" name="Registrar partido"><bpmn:incoming>Flujo_2</bpmn:incoming><bpmn:incoming>Flujo_11</bpmn:incoming><bpmn:outgoing>Flujo_3</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P03_s1" name="Validar conflictos y localía"><bpmn:incoming>Flujo_3</bpmn:incoming><bpmn:incoming>Flujo_6</bpmn:incoming><bpmn:outgoing>Flujo_4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P03_g1" name="¿Conflicto duro?"><bpmn:incoming>Flujo_4</bpmn:incoming><bpmn:outgoing>Flujo_5</bpmn:outgoing><bpmn:outgoing>Flujo_7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P03_t3" name="Corregir partido"><bpmn:incoming>Flujo_5</bpmn:incoming><bpmn:incoming>Flujo_17</bpmn:incoming><bpmn:outgoing>Flujo_6</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P03_g2" name="¿Advertencia de localía?"><bpmn:incoming>Flujo_7</bpmn:incoming><bpmn:outgoing>Flujo_8</bpmn:outgoing><bpmn:outgoing>Flujo_9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P03_t4" name="Aceptar con motivo"><bpmn:incoming>Flujo_8</bpmn:incoming><bpmn:outgoing>Flujo_10</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P03_g3" name="¿Más partidos?"><bpmn:incoming>Flujo_9</bpmn:incoming><bpmn:incoming>Flujo_10</bpmn:incoming><bpmn:outgoing>Flujo_11</bpmn:outgoing><bpmn:outgoing>Flujo_12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P03_c1" name="Designar árbitros"><bpmn:incoming>Flujo_12</bpmn:incoming><bpmn:outgoing>Flujo_13</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P03_s2" name="Validar árbitro ajeno a los clubes"><bpmn:incoming>Flujo_13</bpmn:incoming><bpmn:outgoing>Flujo_14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P03_t5" name="Enviar jornada a aprobación"><bpmn:incoming>Flujo_14</bpmn:incoming><bpmn:outgoing>Flujo_15</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P03_p1" name="Revisar jornada"><bpmn:incoming>Flujo_15</bpmn:incoming><bpmn:outgoing>Flujo_16</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P03_g4" name="¿Aprobada?"><bpmn:incoming>Flujo_16</bpmn:incoming><bpmn:outgoing>Flujo_17</bpmn:outgoing><bpmn:outgoing>Flujo_18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P03_s3" name="Publicar programación"><bpmn:incoming>Flujo_18</bpmn:incoming><bpmn:outgoing>Flujo_19</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P03_s4" name="Generar cobros de la jornada"><bpmn:incoming>Flujo_19</bpmn:incoming><bpmn:outgoing>Flujo_20</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P03_s5" name="Notificar a clubes y árbitros"><bpmn:incoming>Flujo_20</bpmn:incoming><bpmn:outgoing>Flujo_21</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P03_f1" name="Jornada publicada"><bpmn:incoming>Flujo_21</bpmn:incoming></bpmn:endEvent>

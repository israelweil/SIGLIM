  id="Definiciones_P13" targetNamespace="https://github.com/israelweil/SIGLIM/bpmn"
  exporter="SIGLIM generar_bpmn.py" exporterVersion="2.0">
  <bpmn:collaboration id="Colaboracion_P13">
    <bpmn:documentation>P-13 Cambio de permisos con control dual. Modificar los permisos de un rol sin romper la separación de funciones.</bpmn:documentation>
    <bpmn:participant id="Pool_P13" name="Liga Municipal de Futbol Amateur Morelia — SIGLIM" processRef="Proceso_P13"/>
  </bpmn:collaboration>
  <bpmn:process id="Proceso_P13" name="P-13 Cambio de permisos con control dual" isExecutable="false">
    <bpmn:laneSet id="Carriles_P13"><bpmn:lane id="Carril_adm" name="Administrador general"><bpmn:flowNodeRef>P13_i</bpmn:flowNodeRef><bpmn:flowNodeRef>P13_a1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_pre" name="Presidente del Comité Ejecutivo"><bpmn:flowNodeRef>P13_p1</bpmn:flowNodeRef><bpmn:flowNodeRef>P13_g3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_sis" name="Sistema"><bpmn:flowNodeRef>P13_g1</bpmn:flowNodeRef><bpmn:flowNodeRef>P13_s0</bpmn:flowNodeRef><bpmn:flowNodeRef>P13_g2</bpmn:flowNodeRef><bpmn:flowNodeRef>P13_s1</bpmn:flowNodeRef><bpmn:flowNodeRef>P13_s2</bpmn:flowNodeRef><bpmn:flowNodeRef>P13_f1</bpmn:flowNodeRef><bpmn:flowNodeRef>P13_f2</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
        <bpmn:startEvent id="P13_i" name="Ajuste de permisos"><bpmn:outgoing>Flujo_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P13_a1" name="Editar permisos del rol con motivo"><bpmn:incoming>Flujo_1</bpmn:incoming><bpmn:outgoing>Flujo_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P13_g1" name="¿Es su propio rol?"><bpmn:incoming>Flujo_2</bpmn:incoming><bpmn:outgoing>Flujo_3</bpmn:outgoing><bpmn:outgoing>Flujo_4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P13_s0" name="Denegar y auditar"><bpmn:incoming>Flujo_3</bpmn:incoming><bpmn:outgoing>Flujo_11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P13_g2" name="¿Crea un par incompatible?"><bpmn:incoming>Flujo_4</bpmn:incoming><bpmn:outgoing>Flujo_5</bpmn:outgoing><bpmn:outgoing>Flujo_6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P13_p1" name="Revisar cambio"><bpmn:incoming>Flujo_6</bpmn:incoming><bpmn:outgoing>Flujo_7</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P13_g3" name="¿Aprueba?"><bpmn:incoming>Flujo_7</bpmn:incoming><bpmn:outgoing>Flujo_8</bpmn:outgoing><bpmn:outgoing>Flujo_9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P13_s1" name="Aplicar y auditar cambio"><bpmn:incoming>Flujo_5</bpmn:incoming><bpmn:incoming>Flujo_8</bpmn:incoming><bpmn:outgoing>Flujo_10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P13_s2" name="Rechazar y auditar"><bpmn:incoming>Flujo_9</bpmn:incoming><bpmn:outgoing>Flujo_12</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P13_f1" name="Permisos actualizados"><bpmn:incoming>Flujo_10</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P13_f2" name="Cambio no aplicado"><bpmn:incoming>Flujo_11</bpmn:incoming><bpmn:incoming>Flujo_12</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_1" sourceRef="P13_i" targetRef="P13_a1"/>
    <bpmn:sequenceFlow id="Flujo_2" sourceRef="P13_a1" targetRef="P13_g1"/>
    <bpmn:sequenceFlow id="Flujo_3" name="Sí" sourceRef="P13_g1" targetRef="P13_s0"/>
    <bpmn:sequenceFlow id="Flujo_4" name="No" sourceRef="P13_g1" targetRef="P13_g2"/>
    <bpmn:sequenceFlow id="Flujo_5" name="No" sourceRef="P13_g2" targetRef="P13_s1"/>
    <bpmn:sequenceFlow id="Flujo_6" name="Sí" sourceRef="P13_g2" targetRef="P13_p1"/>
    <bpmn:sequenceFlow id="Flujo_7" sourceRef="P13_p1" targetRef="P13_g3"/>
    <bpmn:sequenceFlow id="Flujo_8" name="Sí" sourceRef="P13_g3" targetRef="P13_s1"/>
    <bpmn:sequenceFlow id="Flujo_9" name="No" sourceRef="P13_g3" targetRef="P13_s2"/>
    <bpmn:sequenceFlow id="Flujo_10" sourceRef="P13_s1" targetRef="P13_f1"/>
    <bpmn:sequenceFlow id="Flujo_11" sourceRef="P13_s0" targetRef="P13_f2"/>
    <bpmn:sequenceFlow id="Flujo_12" sourceRef="P13_s2" targetRef="P13_f2"/>
  </bpmn:process>

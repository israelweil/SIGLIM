<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definiciones_P08" targetNamespace="https://github.com/israelweil/SIGLIM/bpmn"
  exporter="SIGLIM generar_bpmn.py" exporterVersion="2.0">
  <bpmn:collaboration id="Colaboracion_P08">
    <bpmn:documentation>P-08 Liguilla y fases finales. Configurar y llevar la fase final hasta determinar campeón y subcampeón.</bpmn:documentation>
    <bpmn:participant id="Pool_P08" name="Liga Municipal de Futbol Amateur Morelia — SIGLIM" processRef="Proceso_P08"/>
  </bpmn:collaboration>
  <bpmn:process id="Proceso_P08" name="P-08 Liguilla y fases finales" isExecutable="false">
    <bpmn:laneSet id="Carriles_P08"><bpmn:lane id="Carril_pro" name="Programador de partidos"><bpmn:flowNodeRef>P08_i</bpmn:flowNodeRef><bpmn:flowNodeRef>P08_t1</bpmn:flowNodeRef><bpmn:flowNodeRef>P08_t2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_sis" name="Sistema"><bpmn:flowNodeRef>P08_s1</bpmn:flowNodeRef><bpmn:flowNodeRef>P08_s2</bpmn:flowNodeRef><bpmn:flowNodeRef>P08_m1</bpmn:flowNodeRef><bpmn:flowNodeRef>P08_s3</bpmn:flowNodeRef><bpmn:flowNodeRef>P08_g1</bpmn:flowNodeRef><bpmn:flowNodeRef>P08_s4</bpmn:flowNodeRef><bpmn:flowNodeRef>P08_f1</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
        <bpmn:startEvent id="P08_i" name="Cierre de fase regular"><bpmn:outgoing>Flujo_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P08_t1" name="Configurar fase final"><bpmn:incoming>Flujo_1</bpmn:incoming><bpmn:outgoing>Flujo_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P08_s1" name="Clasificar equipos"><bpmn:incoming>Flujo_2</bpmn:incoming><bpmn:outgoing>Flujo_3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P08_s2" name="Generar llaves"><bpmn:incoming>Flujo_3</bpmn:incoming><bpmn:outgoing>Flujo_4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P08_t2" name="Programar partidos de la ronda (P-03)"><bpmn:incoming>Flujo_4</bpmn:incoming><bpmn:incoming>Flujo_8</bpmn:incoming><bpmn:outgoing>Flujo_5</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P08_m1" name="Resultados oficiales de la ronda (P-05)"><bpmn:incoming>Flujo_5</bpmn:incoming><bpmn:outgoing>Flujo_6</bpmn:outgoing><bpmn:messageEventDefinition/></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="P08_s3" name="Registrar avances y eliminaciones"><bpmn:incoming>Flujo_6</bpmn:incoming><bpmn:outgoing>Flujo_7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P08_g1" name="¿Fue la final?"><bpmn:incoming>Flujo_7</bpmn:incoming><bpmn:outgoing>Flujo_8</bpmn:outgoing><bpmn:outgoing>Flujo_9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P08_s4" name="Registrar campeón y subcampeón"><bpmn:incoming>Flujo_9</bpmn:incoming><bpmn:outgoing>Flujo_10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P08_f1" name="Competencia concluida"><bpmn:incoming>Flujo_10</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_1" sourceRef="P08_i" targetRef="P08_t1"/>
    <bpmn:sequenceFlow id="Flujo_2" sourceRef="P08_t1" targetRef="P08_s1"/>
    <bpmn:sequenceFlow id="Flujo_3" sourceRef="P08_s1" targetRef="P08_s2"/>
    <bpmn:sequenceFlow id="Flujo_4" sourceRef="P08_s2" targetRef="P08_t2"/>
    <bpmn:sequenceFlow id="Flujo_5" sourceRef="P08_t2" targetRef="P08_m1"/>
    <bpmn:sequenceFlow id="Flujo_6" sourceRef="P08_m1" targetRef="P08_s3"/>
    <bpmn:sequenceFlow id="Flujo_7" sourceRef="P08_s3" targetRef="P08_g1"/>
    <bpmn:sequenceFlow id="Flujo_8" name="No" sourceRef="P08_g1" targetRef="P08_t2"/>
    <bpmn:sequenceFlow id="Flujo_9" name="Sí" sourceRef="P08_g1" targetRef="P08_s4"/>
    <bpmn:sequenceFlow id="Flujo_10" sourceRef="P08_s4" targetRef="P08_f1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_P08">
    <bpmndi:BPMNPlane id="Plano_P08" bpmnElement="Colaboracion_P08">
      <bpmndi:BPMNShape id="Pool_P08_di" bpmnElement="Pool_P08" isHorizontal="true"><dc:Bounds x="20" y="20" width="1840" height="290"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_pro_di" bpmnElement="Carril_pro" isHorizontal="true"><dc:Bounds x="50" y="20" width="1810" height="145"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_sis_di" bpmnElement="Carril_sis" isHorizontal="true"><dc:Bounds x="50" y="165" width="1810" height="145"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_i_di" bpmnElement="P08_i"><dc:Bounds x="162" y="74" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="105.0" y="114.5" width="150" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_t1_di" bpmnElement="P08_t1"><dc:Bounds x="290" y="52" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_s1_di" bpmnElement="P08_s1"><dc:Bounds x="460" y="198" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_s2_di" bpmnElement="P08_s2"><dc:Bounds x="630" y="198" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_t2_di" bpmnElement="P08_t2"><dc:Bounds x="800" y="52" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_m1_di" bpmnElement="P08_m1"><dc:Bounds x="1012" y="220" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="955.0" y="259.5" width="150" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_s3_di" bpmnElement="P08_s3"><dc:Bounds x="1140" y="198" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_g1_di" bpmnElement="P08_g1"><dc:Bounds x="1345" y="212" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1305.0" y="178.5" width="130" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_s4_di" bpmnElement="P08_s4"><dc:Bounds x="1480" y="198" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_f1_di" bpmnElement="P08_f1"><dc:Bounds x="1692" y="220" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1635.0" y="259.5" width="150" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flujo_1_di" bpmnElement="Flujo_1"><di:waypoint x="198" y="92"/><di:waypoint x="290" y="92"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_2_di" bpmnElement="Flujo_2"><di:waypoint x="410" y="92"/><di:waypoint x="435" y="92"/><di:waypoint x="435" y="238"/><di:waypoint x="460" y="238"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_3_di" bpmnElement="Flujo_3"><di:waypoint x="580" y="238"/><di:waypoint x="630" y="238"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_4_di" bpmnElement="Flujo_4"><di:waypoint x="750" y="238"/><di:waypoint x="775" y="238"/><di:waypoint x="775" y="92"/><di:waypoint x="800" y="92"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_5_di" bpmnElement="Flujo_5"><di:waypoint x="920" y="92"/><di:waypoint x="987" y="92"/><di:waypoint x="987" y="238"/><di:waypoint x="1012" y="238"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_6_di" bpmnElement="Flujo_6"><di:waypoint x="1048" y="238"/><di:waypoint x="1140" y="238"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_7_di" bpmnElement="Flujo_7"><di:waypoint x="1260" y="238"/><di:waypoint x="1345" y="238"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_8_di" bpmnElement="Flujo_8"><di:waypoint x="1395" y="238"/><di:waypoint x="1443" y="238"/><di:waypoint x="1443" y="296"/><di:waypoint x="860" y="296"/><di:waypoint x="860" y="132"/><bpmndi:BPMNLabel><dc:Bounds x="1403" y="278" width="30" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_9_di" bpmnElement="Flujo_9"><di:waypoint x="1395" y="238"/><di:waypoint x="1480" y="238"/><bpmndi:BPMNLabel><dc:Bounds x="1411" y="220" width="30" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_10_di" bpmnElement="Flujo_10"><di:waypoint x="1600" y="238"/><di:waypoint x="1692" y="238"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

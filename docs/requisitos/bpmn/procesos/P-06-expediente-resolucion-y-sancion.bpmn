  <bpmn:collaboration id="Colaboracion_P06">
    <bpmn:documentation>P-06 Expediente, resolución y sanción. Convertir las incidencias en una resolución trazable conforme al reglamento.</bpmn:documentation>
    <bpmn:participant id="Pool_P06" name="Liga Municipal de Futbol Amateur Morelia — SIGLIM" processRef="Proceso_P06"/>
  </bpmn:collaboration>
  <bpmn:process id="Proceso_P06" name="P-06 Expediente, resolución y sanción" isExecutable="false">
    <bpmn:laneSet id="Carriles_P06"><bpmn:lane id="Carril_sis" name="Sistema"><bpmn:flowNodeRef>P06_i</bpmn:flowNodeRef><bpmn:flowNodeRef>P06_s1</bpmn:flowNodeRef><bpmn:flowNodeRef>P06_g2</bpmn:flowNodeRef><bpmn:flowNodeRef>P06_s2</bpmn:flowNodeRef><bpmn:flowNodeRef>P06_s3</bpmn:flowNodeRef><bpmn:flowNodeRef>P06_s4</bpmn:flowNodeRef><bpmn:flowNodeRef>P06_j1</bpmn:flowNodeRef><bpmn:flowNodeRef>P06_s5</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_cdi" name="Comisión Disciplinaria"><bpmn:flowNodeRef>P06_d1</bpmn:flowNodeRef><bpmn:flowNodeRef>P06_g1</bpmn:flowNodeRef><bpmn:flowNodeRef>P06_d0</bpmn:flowNodeRef><bpmn:flowNodeRef>P06_d2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_dir" name="Directiva de club"><bpmn:flowNodeRef>P06_r0</bpmn:flowNodeRef><bpmn:flowNodeRef>P06_r1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_pre" name="Presidente del Comité Ejecutivo"><bpmn:flowNodeRef>P06_p1</bpmn:flowNodeRef><bpmn:flowNodeRef>P06_f1</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
        <bpmn:startEvent id="P06_i" name="Expediente abierto"><bpmn:outgoing>Flujo_1</bpmn:outgoing><bpmn:messageEventDefinition/></bpmn:startEvent>
    <bpmn:userTask id="P06_d1" name="Revisar incidencias y evidencias"><bpmn:incoming>Flujo_1</bpmn:incoming><bpmn:incoming>Flujo_4</bpmn:incoming><bpmn:outgoing>Flujo_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P06_g1" name="¿Artículo identificado?"><bpmn:incoming>Flujo_2</bpmn:incoming><bpmn:outgoing>Flujo_3</bpmn:outgoing><bpmn:outgoing>Flujo_5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P06_d0" name="Dejar en revisión y solicitar información"><bpmn:incoming>Flujo_3</bpmn:incoming><bpmn:outgoing>Flujo_4</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P06_d2" name="Resolver sanción"><bpmn:incoming>Flujo_5</bpmn:incoming><bpmn:outgoing>Flujo_6</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P06_s1" name="Calcular vigencia"><bpmn:incoming>Flujo_6</bpmn:incoming><bpmn:outgoing>Flujo_7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P06_g2" name="¿Tipo de sanción?"><bpmn:incoming>Flujo_7</bpmn:incoming><bpmn:outgoing>Flujo_8</bpmn:outgoing><bpmn:outgoing>Flujo_9</bpmn:outgoing><bpmn:outgoing>Flujo_10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P06_s2" name="Suspender elegibilidad del jugador"><bpmn:incoming>Flujo_8</bpmn:incoming><bpmn:outgoing>Flujo_11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P06_s3" name="Dar de baja y resolver partidos restantes"><bpmn:incoming>Flujo_9</bpmn:incoming><bpmn:outgoing>Flujo_12</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P06_s4" name="Generar cobro por multa"><bpmn:incoming>Flujo_10</bpmn:incoming><bpmn:outgoing>Flujo_13</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P06_j1" name=""><bpmn:incoming>Flujo_11</bpmn:incoming><bpmn:incoming>Flujo_12</bpmn:incoming><bpmn:incoming>Flujo_13</bpmn:incoming><bpmn:outgoing>Flujo_14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P06_s5" name="Recalcular tabla y notificar"><bpmn:incoming>Flujo_14</bpmn:incoming><bpmn:outgoing>Flujo_15</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P06_r0" name="¿Interpone recurso?"><bpmn:incoming>Flujo_15</bpmn:incoming><bpmn:outgoing>Flujo_16</bpmn:outgoing><bpmn:outgoing>Flujo_17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P06_r1" name="Interponer recurso"><bpmn:incoming>Flujo_16</bpmn:incoming><bpmn:outgoing>Flujo_18</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P06_p1" name="Resolver recurso"><bpmn:incoming>Flujo_18</bpmn:incoming><bpmn:outgoing>Flujo_19</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P06_f1" name="Expediente cerrado"><bpmn:incoming>Flujo_17</bpmn:incoming><bpmn:incoming>Flujo_19</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_1" sourceRef="P06_i" targetRef="P06_d1"/>
    <bpmn:sequenceFlow id="Flujo_2" sourceRef="P06_d1" targetRef="P06_g1"/>

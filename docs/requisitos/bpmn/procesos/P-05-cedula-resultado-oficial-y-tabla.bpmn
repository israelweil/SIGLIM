<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definiciones_P05" targetNamespace="https://github.com/israelweil/SIGLIM/bpmn"
  exporter="SIGLIM generar_bpmn.py" exporterVersion="2.0">
  <bpmn:collaboration id="Colaboracion_P05">
    <bpmn:documentation>P-05 Cédula, resultado oficial y tabla. Capturar la cédula, validarla y oficializar el resultado.</bpmn:documentation>
    <bpmn:participant id="Pool_P05" name="Liga Municipal de Futbol Amateur Morelia — SIGLIM" processRef="Proceso_P05"/>
  </bpmn:collaboration>
  <bpmn:process id="Proceso_P05" name="P-05 Cédula, resultado oficial y tabla" isExecutable="false">
    <bpmn:laneSet id="Carriles_P05"><bpmn:lane id="Carril_cap" name="Capturista"><bpmn:flowNodeRef>P05_i</bpmn:flowNodeRef><bpmn:flowNodeRef>P05_c1</bpmn:flowNodeRef><bpmn:flowNodeRef>P05_c2</bpmn:flowNodeRef><bpmn:flowNodeRef>P05_g1</bpmn:flowNodeRef><bpmn:flowNodeRef>P05_c3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_arb" name="Árbitro designado"><bpmn:flowNodeRef>P05_a1</bpmn:flowNodeRef><bpmn:flowNodeRef>P05_b1</bpmn:flowNodeRef><bpmn:flowNodeRef>P05_g2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_car" name="Comisión de Arbitraje"><bpmn:flowNodeRef>P05_k1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_sis" name="Sistema"><bpmn:flowNodeRef>P05_s0</bpmn:flowNodeRef><bpmn:flowNodeRef>P05_s1</bpmn:flowNodeRef><bpmn:flowNodeRef>P05_s2</bpmn:flowNodeRef><bpmn:flowNodeRef>P05_s3</bpmn:flowNodeRef><bpmn:flowNodeRef>P05_s4</bpmn:flowNodeRef><bpmn:flowNodeRef>P05_s5</bpmn:flowNodeRef><bpmn:flowNodeRef>P05_f1</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
        <bpmn:startEvent id="P05_i" name="Partido terminado"><bpmn:outgoing>Flujo_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P05_c1" name="Capturar alineaciones"><bpmn:incoming>Flujo_1</bpmn:incoming><bpmn:outgoing>Flujo_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P05_s0" name="Validar elegibilidad y categoría superior"><bpmn:incoming>Flujo_2</bpmn:incoming><bpmn:outgoing>Flujo_3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P05_c2" name="Capturar marcador, goles, tarjetas e incidencias"><bpmn:incoming>Flujo_3</bpmn:incoming><bpmn:incoming>Flujo_5</bpmn:incoming><bpmn:incoming>Flujo_10</bpmn:incoming><bpmn:outgoing>Flujo_4</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P05_g1" name="¿Campos completos?"><bpmn:incoming>Flujo_4</bpmn:incoming><bpmn:outgoing>Flujo_5</bpmn:outgoing><bpmn:outgoing>Flujo_6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P05_c3" name="Enviar a validación"><bpmn:incoming>Flujo_6</bpmn:incoming><bpmn:outgoing>Flujo_7</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P05_s1" name="Notificar al árbitro"><bpmn:incoming>Flujo_7</bpmn:incoming><bpmn:outgoing>Flujo_8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P05_a1" name="Revisar cédula"><bpmn:incoming>Flujo_8</bpmn:incoming><bpmn:outgoing>Flujo_9</bpmn:outgoing></bpmn:userTask>
    <bpmn:boundaryEvent id="P05_b1" name="Plazo vencido (48 h)" attachedToRef="P05_a1" cancelActivity="true"><bpmn:outgoing>Flujo_12</bpmn:outgoing><bpmn:timerEventDefinition/></bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="P05_g2" name="¿Aprueba?"><bpmn:incoming>Flujo_9</bpmn:incoming><bpmn:outgoing>Flujo_10</bpmn:outgoing><bpmn:outgoing>Flujo_11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P05_k1" name="Aprobar cédula vencida"><bpmn:incoming>Flujo_12</bpmn:incoming><bpmn:outgoing>Flujo_13</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P05_s2" name="Oficializar resultado y finalizar partido"><bpmn:incoming>Flujo_11</bpmn:incoming><bpmn:incoming>Flujo_13</bpmn:incoming><bpmn:outgoing>Flujo_14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P05_s3" name="Recalcular tabla"><bpmn:incoming>Flujo_14</bpmn:incoming><bpmn:outgoing>Flujo_15</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P05_s4" name="Publicar resultado"><bpmn:incoming>Flujo_15</bpmn:incoming><bpmn:outgoing>Flujo_16</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P05_s5" name="Abrir expedientes según tipo de incidencia"><bpmn:incoming>Flujo_16</bpmn:incoming><bpmn:outgoing>Flujo_17</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P05_f1" name="Resultado oficial"><bpmn:incoming>Flujo_17</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_1" sourceRef="P05_i" targetRef="P05_c1"/>
    <bpmn:sequenceFlow id="Flujo_2" sourceRef="P05_c1" targetRef="P05_s0"/>
    <bpmn:sequenceFlow id="Flujo_3" sourceRef="P05_s0" targetRef="P05_c2"/>
    <bpmn:sequenceFlow id="Flujo_4" sourceRef="P05_c2" targetRef="P05_g1"/>
    <bpmn:sequenceFlow id="Flujo_5" name="No" sourceRef="P05_g1" targetRef="P05_c2"/>
    <bpmn:sequenceFlow id="Flujo_6" name="Sí" sourceRef="P05_g1" targetRef="P05_c3"/>
    <bpmn:sequenceFlow id="Flujo_7" sourceRef="P05_c3" targetRef="P05_s1"/>
    <bpmn:sequenceFlow id="Flujo_8" sourceRef="P05_s1" targetRef="P05_a1"/>
    <bpmn:sequenceFlow id="Flujo_9" sourceRef="P05_a1" targetRef="P05_g2"/>
    <bpmn:sequenceFlow id="Flujo_10" name="No, devuelve" sourceRef="P05_g2" targetRef="P05_c2"/>
    <bpmn:sequenceFlow id="Flujo_11" name="Sí" sourceRef="P05_g2" targetRef="P05_s2"/>
    <bpmn:sequenceFlow id="Flujo_12" sourceRef="P05_b1" targetRef="P05_k1"/>
    <bpmn:sequenceFlow id="Flujo_13" sourceRef="P05_k1" targetRef="P05_s2"/>
    <bpmn:sequenceFlow id="Flujo_14" sourceRef="P05_s2" targetRef="P05_s3"/>
    <bpmn:sequenceFlow id="Flujo_15" sourceRef="P05_s3" targetRef="P05_s4"/>
    <bpmn:sequenceFlow id="Flujo_16" sourceRef="P05_s4" targetRef="P05_s5"/>
    <bpmn:sequenceFlow id="Flujo_17" sourceRef="P05_s5" targetRef="P05_f1"/>
  </bpmn:process>

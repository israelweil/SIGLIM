<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definiciones_P07" targetNamespace="https://github.com/israelweil/SIGLIM/bpmn"
  exporter="SIGLIM generar_bpmn.py" exporterVersion="2.0">
  <bpmn:collaboration id="Colaboracion_P07">
    <bpmn:documentation>P-07 Ascenso, descenso y clasificación. Proponer y validar ascensos y descensos al cierre de la fase regular.</bpmn:documentation>
    <bpmn:participant id="Pool_P07" name="Liga Municipal de Futbol Amateur Morelia — SIGLIM" processRef="Proceso_P07"/>
  </bpmn:collaboration>
  <bpmn:process id="Proceso_P07" name="P-07 Ascenso, descenso y clasificación" isExecutable="false">
    <bpmn:laneSet id="Carriles_P07"><bpmn:lane id="Carril_sis" name="Sistema"><bpmn:flowNodeRef>P07_i</bpmn:flowNodeRef><bpmn:flowNodeRef>P07_s1</bpmn:flowNodeRef><bpmn:flowNodeRef>P07_s2</bpmn:flowNodeRef><bpmn:flowNodeRef>P07_s3</bpmn:flowNodeRef><bpmn:flowNodeRef>P07_s4</bpmn:flowNodeRef><bpmn:flowNodeRef>P07_s5</bpmn:flowNodeRef><bpmn:flowNodeRef>P07_f1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_pre" name="Presidente del Comité Ejecutivo"><bpmn:flowNodeRef>P07_p1</bpmn:flowNodeRef><bpmn:flowNodeRef>P07_g1</bpmn:flowNodeRef><bpmn:flowNodeRef>P07_p2</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
        <bpmn:startEvent id="P07_i" name="Cierre de fase regular"><bpmn:outgoing>Flujo_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P07_s1" name="Cargar versión de reglas"><bpmn:incoming>Flujo_1</bpmn:incoming><bpmn:outgoing>Flujo_2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P07_s2" name="Determinar posiciones finales"><bpmn:incoming>Flujo_2</bpmn:incoming><bpmn:outgoing>Flujo_3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P07_s3" name="Excluir equipos no elegibles"><bpmn:incoming>Flujo_3</bpmn:incoming><bpmn:outgoing>Flujo_4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P07_s4" name="Generar propuesta"><bpmn:incoming>Flujo_4</bpmn:incoming><bpmn:incoming>Flujo_8</bpmn:incoming><bpmn:outgoing>Flujo_5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P07_p1" name="Revisar propuesta"><bpmn:incoming>Flujo_5</bpmn:incoming><bpmn:outgoing>Flujo_6</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P07_g1" name="¿Valida?"><bpmn:incoming>Flujo_6</bpmn:incoming><bpmn:outgoing>Flujo_7</bpmn:outgoing><bpmn:outgoing>Flujo_9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P07_p2" name="Registrar observaciones"><bpmn:incoming>Flujo_7</bpmn:incoming><bpmn:outgoing>Flujo_8</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P07_s5" name="Registrar determinación"><bpmn:incoming>Flujo_9</bpmn:incoming><bpmn:outgoing>Flujo_10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P07_f1" name="Ascensos y descensos determinados"><bpmn:incoming>Flujo_10</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_1" sourceRef="P07_i" targetRef="P07_s1"/>
    <bpmn:sequenceFlow id="Flujo_2" sourceRef="P07_s1" targetRef="P07_s2"/>
    <bpmn:sequenceFlow id="Flujo_3" sourceRef="P07_s2" targetRef="P07_s3"/>
    <bpmn:sequenceFlow id="Flujo_4" sourceRef="P07_s3" targetRef="P07_s4"/>
    <bpmn:sequenceFlow id="Flujo_5" sourceRef="P07_s4" targetRef="P07_p1"/>
    <bpmn:sequenceFlow id="Flujo_6" sourceRef="P07_p1" targetRef="P07_g1"/>
    <bpmn:sequenceFlow id="Flujo_7" name="No" sourceRef="P07_g1" targetRef="P07_p2"/>
    <bpmn:sequenceFlow id="Flujo_8" sourceRef="P07_p2" targetRef="P07_s4"/>
    <bpmn:sequenceFlow id="Flujo_9" name="Sí" sourceRef="P07_g1" targetRef="P07_s5"/>
    <bpmn:sequenceFlow id="Flujo_10" sourceRef="P07_s5" targetRef="P07_f1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_P07">
    <bpmndi:BPMNPlane id="Plano_P07" bpmnElement="Colaboracion_P07">
      <bpmndi:BPMNShape id="Pool_P07_di" bpmnElement="Pool_P07" isHorizontal="true"><dc:Bounds x="20" y="20" width="1670" height="290"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_sis_di" bpmnElement="Carril_sis" isHorizontal="true"><dc:Bounds x="50" y="20" width="1640" height="145"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_pre_di" bpmnElement="Carril_pre" isHorizontal="true"><dc:Bounds x="50" y="165" width="1640" height="145"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P07_i_di" bpmnElement="P07_i"><dc:Bounds x="162" y="74" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="105.0" y="114.5" width="150" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P07_s1_di" bpmnElement="P07_s1"><dc:Bounds x="290" y="52" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P07_s2_di" bpmnElement="P07_s2"><dc:Bounds x="460" y="52" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P07_s3_di" bpmnElement="P07_s3"><dc:Bounds x="630" y="52" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P07_s4_di" bpmnElement="P07_s4"><dc:Bounds x="800" y="52" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P07_p1_di" bpmnElement="P07_p1"><dc:Bounds x="970" y="198" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P07_g1_di" bpmnElement="P07_g1"><dc:Bounds x="1175" y="212" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1135.0" y="178.5" width="130" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P07_p2_di" bpmnElement="P07_p2"><dc:Bounds x="1310" y="198" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P07_s5_di" bpmnElement="P07_s5"><dc:Bounds x="1310" y="52" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P07_f1_di" bpmnElement="P07_f1"><dc:Bounds x="1522" y="74" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1465.0" y="114.5" width="150" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flujo_1_di" bpmnElement="Flujo_1"><di:waypoint x="198" y="92"/><di:waypoint x="290" y="92"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_2_di" bpmnElement="Flujo_2"><di:waypoint x="410" y="92"/><di:waypoint x="460" y="92"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_3_di" bpmnElement="Flujo_3"><di:waypoint x="580" y="92"/><di:waypoint x="630" y="92"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_4_di" bpmnElement="Flujo_4"><di:waypoint x="750" y="92"/><di:waypoint x="800" y="92"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_5_di" bpmnElement="Flujo_5"><di:waypoint x="920" y="92"/><di:waypoint x="945" y="92"/><di:waypoint x="945" y="238"/><di:waypoint x="970" y="238"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_6_di" bpmnElement="Flujo_6"><di:waypoint x="1090" y="238"/><di:waypoint x="1175" y="238"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_7_di" bpmnElement="Flujo_7"><di:waypoint x="1225" y="238"/><di:waypoint x="1310" y="238"/><bpmndi:BPMNLabel><dc:Bounds x="1253" y="220" width="30" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_8_di" bpmnElement="Flujo_8"><di:waypoint x="1430" y="238"/><di:waypoint x="1443" y="238"/><di:waypoint x="1443" y="296"/><di:waypoint x="860" y="296"/><di:waypoint x="860" y="132"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_9_di" bpmnElement="Flujo_9"><di:waypoint x="1225" y="238"/><di:waypoint x="1285" y="238"/><di:waypoint x="1285" y="92"/><di:waypoint x="1310" y="92"/><bpmndi:BPMNLabel><dc:Bounds x="1259" y="196" width="30" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_10_di" bpmnElement="Flujo_10"><di:waypoint x="1430" y="92"/><di:waypoint x="1522" y="92"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

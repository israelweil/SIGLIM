      <bpmndi:BPMNShape id="P11_m2_di" bpmnElement="P11_m2"><dc:Bounds x="1012" y="220" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="955.0" y="259.5" width="150" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_t1_di" bpmnElement="P11_t1"><dc:Bounds x="1012" y="364" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="955.0" y="404.5" width="150" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_d1_di" bpmnElement="P11_d1"><dc:Bounds x="1140" y="52" width="120" height="80"/></bpmndi:BPMNShape>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definiciones_P11" targetNamespace="https://github.com/israelweil/SIGLIM/bpmn"
  exporter="SIGLIM generar_bpmn.py" exporterVersion="2.0">
  <bpmn:collaboration id="Colaboracion_P11">
    <bpmn:documentation>P-11 Cobros y pagos. Generar los cobros de la temporada y registrar su pago.</bpmn:documentation>
    <bpmn:participant id="Pool_P11" name="Liga Municipal de Futbol Amateur Morelia — SIGLIM" processRef="Proceso_P11"/>
  </bpmn:collaboration>
  <bpmn:process id="Proceso_P11" name="P-11 Cobros y pagos" isExecutable="false">
    <bpmn:laneSet id="Carriles_P11"><bpmn:lane id="Carril_dir" name="Directiva de club"><bpmn:flowNodeRef>P11_m1</bpmn:flowNodeRef><bpmn:flowNodeRef>P11_d1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_tes" name="Tesorero (liga)"><bpmn:flowNodeRef>P11_o1</bpmn:flowNodeRef><bpmn:flowNodeRef>P11_m2</bpmn:flowNodeRef><bpmn:flowNodeRef>P11_k1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_sis" name="Sistema"><bpmn:flowNodeRef>P11_i</bpmn:flowNodeRef><bpmn:flowNodeRef>P11_g0</bpmn:flowNodeRef><bpmn:flowNodeRef>P11_s1</bpmn:flowNodeRef><bpmn:flowNodeRef>P11_e1</bpmn:flowNodeRef><bpmn:flowNodeRef>P11_t1</bpmn:flowNodeRef><bpmn:flowNodeRef>P11_s2</bpmn:flowNodeRef><bpmn:flowNodeRef>P11_s3</bpmn:flowNodeRef><bpmn:flowNodeRef>P11_f1</bpmn:flowNodeRef><bpmn:flowNodeRef>P11_f2</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
        <bpmn:startEvent id="P11_i" name="Cobro requerido"><bpmn:outgoing>Flujo_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="P11_g0" name="¿Origen del cobro?"><bpmn:incoming>Flujo_1</bpmn:incoming><bpmn:outgoing>Flujo_2</bpmn:outgoing><bpmn:outgoing>Flujo_3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P11_o1" name="Capturar cobro manual"><bpmn:incoming>Flujo_3</bpmn:incoming><bpmn:outgoing>Flujo_4</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P11_s1" name="Registrar cobro Pendiente y notificar"><bpmn:incoming>Flujo_2</bpmn:incoming><bpmn:incoming>Flujo_4</bpmn:incoming><bpmn:outgoing>Flujo_5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:eventBasedGateway id="P11_e1" name=""><bpmn:incoming>Flujo_5</bpmn:incoming><bpmn:outgoing>Flujo_6</bpmn:outgoing><bpmn:outgoing>Flujo_7</bpmn:outgoing><bpmn:outgoing>Flujo_8</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="P11_m1" name="Pago en línea iniciado"><bpmn:incoming>Flujo_6</bpmn:incoming><bpmn:outgoing>Flujo_9</bpmn:outgoing><bpmn:messageEventDefinition/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="P11_m2" name="Pago recibido por otro medio"><bpmn:incoming>Flujo_7</bpmn:incoming><bpmn:outgoing>Flujo_10</bpmn:outgoing><bpmn:messageEventDefinition/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="P11_t1" name="Fin del periodo de pago"><bpmn:incoming>Flujo_8</bpmn:incoming><bpmn:outgoing>Flujo_13</bpmn:outgoing><bpmn:timerEventDefinition/></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="P11_d1" name="Pagar en línea (simulado)"><bpmn:incoming>Flujo_9</bpmn:incoming><bpmn:outgoing>Flujo_11</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P11_k1" name="Registrar pago y comprobante"><bpmn:incoming>Flujo_10</bpmn:incoming><bpmn:outgoing>Flujo_12</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P11_s2" name="Marcar Pagado y actualizar adeudo"><bpmn:incoming>Flujo_11</bpmn:incoming><bpmn:incoming>Flujo_12</bpmn:incoming><bpmn:outgoing>Flujo_14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P11_s3" name="Marcar Vencido y notificar"><bpmn:incoming>Flujo_13</bpmn:incoming><bpmn:outgoing>Flujo_15</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P11_f1" name="Cobro pagado"><bpmn:incoming>Flujo_14</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P11_f2" name="Cobro vencido"><bpmn:incoming>Flujo_15</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_1" sourceRef="P11_i" targetRef="P11_g0"/>
    <bpmn:sequenceFlow id="Flujo_2" name="Jornada o multa" sourceRef="P11_g0" targetRef="P11_s1"/>
    <bpmn:sequenceFlow id="Flujo_3" name="Manual" sourceRef="P11_g0" targetRef="P11_o1"/>
    <bpmn:sequenceFlow id="Flujo_4" sourceRef="P11_o1" targetRef="P11_s1"/>
    <bpmn:sequenceFlow id="Flujo_5" sourceRef="P11_s1" targetRef="P11_e1"/>
    <bpmn:sequenceFlow id="Flujo_6" sourceRef="P11_e1" targetRef="P11_m1"/>
    <bpmn:sequenceFlow id="Flujo_7" sourceRef="P11_e1" targetRef="P11_m2"/>
    <bpmn:sequenceFlow id="Flujo_8" sourceRef="P11_e1" targetRef="P11_t1"/>
    <bpmn:sequenceFlow id="Flujo_9" sourceRef="P11_m1" targetRef="P11_d1"/>
    <bpmn:sequenceFlow id="Flujo_10" sourceRef="P11_m2" targetRef="P11_k1"/>
    <bpmn:sequenceFlow id="Flujo_11" sourceRef="P11_d1" targetRef="P11_s2"/>
    <bpmn:sequenceFlow id="Flujo_12" sourceRef="P11_k1" targetRef="P11_s2"/>
    <bpmn:sequenceFlow id="Flujo_13" sourceRef="P11_t1" targetRef="P11_s3"/>
    <bpmn:sequenceFlow id="Flujo_14" sourceRef="P11_s2" targetRef="P11_f1"/>
    <bpmn:sequenceFlow id="Flujo_15" sourceRef="P11_s3" targetRef="P11_f2"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_P11">
    <bpmndi:BPMNPlane id="Plano_P11" bpmnElement="Colaboracion_P11">
      <bpmndi:BPMNShape id="Pool_P11_di" bpmnElement="Pool_P11" isHorizontal="true"><dc:Bounds x="20" y="20" width="1670" height="560"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_dir_di" bpmnElement="Carril_dir" isHorizontal="true"><dc:Bounds x="50" y="20" width="1640" height="145"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_tes_di" bpmnElement="Carril_tes" isHorizontal="true"><dc:Bounds x="50" y="165" width="1640" height="145"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_sis_di" bpmnElement="Carril_sis" isHorizontal="true"><dc:Bounds x="50" y="310" width="1640" height="270"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_i_di" bpmnElement="P11_i"><dc:Bounds x="162" y="364" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="105.0" y="404.5" width="150" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="P11_s3_di" bpmnElement="P11_s3"><dc:Bounds x="1140" y="342" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_f1_di" bpmnElement="P11_f1"><dc:Bounds x="1522" y="364" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1465.0" y="404.5" width="150" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_f2_di" bpmnElement="P11_f2"><dc:Bounds x="1352" y="490" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1295.0" y="529.5" width="150" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flujo_4_di" bpmnElement="Flujo_4"><di:waypoint x="580" y="238"/><di:waypoint x="605" y="238"/><di:waypoint x="605" y="382"/><di:waypoint x="630" y="382"/></bpmndi:BPMNEdge>

      <bpmndi:BPMNShape id="P01_f1_di" bpmnElement="P01_f1"><dc:Bounds x="1862" y="634" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1805.0" y="674.5" width="150" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P01_f2_di" bpmnElement="P01_f2"><dc:Bounds x="1862" y="510" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1805.0" y="549.5" width="150" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flujo_1_di" bpmnElement="Flujo_1"><di:waypoint x="198" y="92"/><di:waypoint x="290" y="92"/></bpmndi:BPMNEdge>

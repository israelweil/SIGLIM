<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definiciones_P01" targetNamespace="https://github.com/israelweil/SIGLIM/bpmn"
  exporter="SIGLIM generar_bpmn.py" exporterVersion="2.0">
  <bpmn:collaboration id="Colaboracion_P01">
    <bpmn:documentation>P-01 Configuración de temporada. Preparar el marco deportivo y normativo de una temporada.</bpmn:documentation>
    <bpmn:participant id="Pool_P01" name="Liga Municipal de Futbol Amateur Morelia — SIGLIM" processRef="Proceso_P01"/>
  </bpmn:collaboration>
  <bpmn:process id="Proceso_P01" name="P-01 Configuración de temporada" isExecutable="false">
    <bpmn:laneSet id="Carriles_P01"><bpmn:lane id="Carril_adm" name="Administrador general"><bpmn:flowNodeRef>P01_i</bpmn:flowNodeRef><bpmn:flowNodeRef>P01_t1</bpmn:flowNodeRef><bpmn:flowNodeRef>P01_t2</bpmn:flowNodeRef><bpmn:flowNodeRef>P01_t3</bpmn:flowNodeRef><bpmn:flowNodeRef>P01_g1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_pre" name="Presidente del Comité Ejecutivo"><bpmn:flowNodeRef>P01_p1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_tes" name="Tesorero (liga)"><bpmn:flowNodeRef>P01_t4</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_sis" name="Sistema"><bpmn:flowNodeRef>P01_s1</bpmn:flowNodeRef><bpmn:flowNodeRef>P01_g2</bpmn:flowNodeRef><bpmn:flowNodeRef>P01_s2</bpmn:flowNodeRef><bpmn:flowNodeRef>P01_s3</bpmn:flowNodeRef><bpmn:flowNodeRef>P01_f1</bpmn:flowNodeRef><bpmn:flowNodeRef>P01_f2</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
        <bpmn:startEvent id="P01_i" name="Nueva temporada"><bpmn:outgoing>Flujo_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P01_t1" name="Registrar temporada"><bpmn:incoming>Flujo_1</bpmn:incoming><bpmn:outgoing>Flujo_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P01_t2" name="Seleccionar categorías y crear grupos"><bpmn:incoming>Flujo_2</bpmn:incoming><bpmn:outgoing>Flujo_3</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P01_t3" name="Configurar parámetros deportivos"><bpmn:incoming>Flujo_3</bpmn:incoming><bpmn:outgoing>Flujo_4</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P01_g1" name="¿Regla interpretada?"><bpmn:incoming>Flujo_4</bpmn:incoming><bpmn:outgoing>Flujo_5</bpmn:outgoing><bpmn:outgoing>Flujo_6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P01_p1" name="Autorizar o rechazar interpretación"><bpmn:incoming>Flujo_5</bpmn:incoming><bpmn:outgoing>Flujo_7</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P01_t4" name="Configurar tarifas de arbitraje y cancha"><bpmn:incoming>Flujo_6</bpmn:incoming><bpmn:incoming>Flujo_7</bpmn:incoming><bpmn:outgoing>Flujo_8</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P01_s1" name="Versionar configuración"><bpmn:incoming>Flujo_8</bpmn:incoming><bpmn:outgoing>Flujo_9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P01_g2" name="¿Otra temporada activa?"><bpmn:incoming>Flujo_9</bpmn:incoming><bpmn:outgoing>Flujo_10</bpmn:outgoing><bpmn:outgoing>Flujo_11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P01_s2" name="Rechazar activación"><bpmn:incoming>Flujo_10</bpmn:incoming><bpmn:outgoing>Flujo_13</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P01_s3" name="Activar temporada"><bpmn:incoming>Flujo_11</bpmn:incoming><bpmn:outgoing>Flujo_12</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P01_f1" name="Temporada activa"><bpmn:incoming>Flujo_12</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P01_f2" name="Activación rechazada"><bpmn:incoming>Flujo_13</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_1" sourceRef="P01_i" targetRef="P01_t1"/>
    <bpmn:sequenceFlow id="Flujo_2" sourceRef="P01_t1" targetRef="P01_t2"/>
    <bpmn:sequenceFlow id="Flujo_3" sourceRef="P01_t2" targetRef="P01_t3"/>
    <bpmn:sequenceFlow id="Flujo_4" sourceRef="P01_t3" targetRef="P01_g1"/>
    <bpmn:sequenceFlow id="Flujo_5" name="Sí" sourceRef="P01_g1" targetRef="P01_p1"/>
    <bpmn:sequenceFlow id="Flujo_6" name="No" sourceRef="P01_g1" targetRef="P01_t4"/>
    <bpmn:sequenceFlow id="Flujo_7" sourceRef="P01_p1" targetRef="P01_t4"/>
    <bpmn:sequenceFlow id="Flujo_8" sourceRef="P01_t4" targetRef="P01_s1"/>
    <bpmn:sequenceFlow id="Flujo_9" sourceRef="P01_s1" targetRef="P01_g2"/>
    <bpmn:sequenceFlow id="Flujo_10" name="Sí" sourceRef="P01_g2" targetRef="P01_s2"/>
    <bpmn:sequenceFlow id="Flujo_11" name="No" sourceRef="P01_g2" targetRef="P01_s3"/>
    <bpmn:sequenceFlow id="Flujo_12" sourceRef="P01_s3" targetRef="P01_f1"/>
    <bpmn:sequenceFlow id="Flujo_13" sourceRef="P01_s2" targetRef="P01_f2"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_P01">
    <bpmndi:BPMNPlane id="Plano_P01" bpmnElement="Colaboracion_P01">
      <bpmndi:BPMNShape id="Pool_P01_di" bpmnElement="Pool_P01" isHorizontal="true"><dc:Bounds x="20" y="20" width="2010" height="705"/></bpmndi:BPMNShape>

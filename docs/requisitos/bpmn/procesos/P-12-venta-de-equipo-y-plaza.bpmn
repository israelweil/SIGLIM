<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definiciones_P12" targetNamespace="https://github.com/israelweil/SIGLIM/bpmn"
  exporter="SIGLIM generar_bpmn.py" exporterVersion="2.0">
  <bpmn:collaboration id="Colaboracion_P12">
    <bpmn:documentation>P-12 Venta de equipo y conservación de plaza. Registrar el cambio de propietario de un equipo y, por separado, la conservación de su plaza.</bpmn:documentation>
    <bpmn:participant id="Pool_P12" name="Liga Municipal de Futbol Amateur Morelia — SIGLIM" processRef="Proceso_P12"/>
  </bpmn:collaboration>
  <bpmn:process id="Proceso_P12" name="P-12 Venta de equipo y conservación de plaza" isExecutable="false">
    <bpmn:laneSet id="Carriles_P12"><bpmn:lane id="Carril_dir" name="Directiva de club"><bpmn:flowNodeRef>P12_i</bpmn:flowNodeRef><bpmn:flowNodeRef>P12_d1</bpmn:flowNodeRef><bpmn:flowNodeRef>P12_d2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_pre" name="Presidente del Comité Ejecutivo"><bpmn:flowNodeRef>P12_p1</bpmn:flowNodeRef><bpmn:flowNodeRef>P12_g1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_sis" name="Sistema"><bpmn:flowNodeRef>P12_s0</bpmn:flowNodeRef><bpmn:flowNodeRef>P12_t1</bpmn:flowNodeRef><bpmn:flowNodeRef>P12_s1</bpmn:flowNodeRef><bpmn:flowNodeRef>P12_f1</bpmn:flowNodeRef><bpmn:flowNodeRef>P12_f2</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
        <bpmn:startEvent id="P12_i" name="Acuerdo de venta"><bpmn:outgoing>Flujo_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P12_d1" name="Registrar venta del equipo"><bpmn:incoming>Flujo_1</bpmn:incoming><bpmn:outgoing>Flujo_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P12_d2" name="Solicitar conservación de categoría y plaza"><bpmn:incoming>Flujo_2</bpmn:incoming><bpmn:outgoing>Flujo_3</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P12_p1" name="Autorizar venta y plaza"><bpmn:incoming>Flujo_3</bpmn:incoming><bpmn:outgoing>Flujo_4</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P12_g1" name="¿Autoriza?"><bpmn:incoming>Flujo_4</bpmn:incoming><bpmn:outgoing>Flujo_5</bpmn:outgoing><bpmn:outgoing>Flujo_6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P12_s0" name="Registrar rechazo"><bpmn:incoming>Flujo_6</bpmn:incoming><bpmn:outgoing>Flujo_9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="P12_t1" name="Cierre de la temporada"><bpmn:incoming>Flujo_5</bpmn:incoming><bpmn:outgoing>Flujo_7</bpmn:outgoing><bpmn:timerEventDefinition/></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="P12_s1" name="Aplicar cambio de propietario y plaza"><bpmn:incoming>Flujo_7</bpmn:incoming><bpmn:outgoing>Flujo_8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P12_f1" name="Propietario actualizado"><bpmn:incoming>Flujo_8</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P12_f2" name="Venta rechazada"><bpmn:incoming>Flujo_9</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_1" sourceRef="P12_i" targetRef="P12_d1"/>
    <bpmn:sequenceFlow id="Flujo_2" sourceRef="P12_d1" targetRef="P12_d2"/>
    <bpmn:sequenceFlow id="Flujo_3" sourceRef="P12_d2" targetRef="P12_p1"/>
    <bpmn:sequenceFlow id="Flujo_4" sourceRef="P12_p1" targetRef="P12_g1"/>
    <bpmn:sequenceFlow id="Flujo_5" name="Sí" sourceRef="P12_g1" targetRef="P12_t1"/>
    <bpmn:sequenceFlow id="Flujo_6" name="No" sourceRef="P12_g1" targetRef="P12_s0"/>
    <bpmn:sequenceFlow id="Flujo_7" sourceRef="P12_t1" targetRef="P12_s1"/>
    <bpmn:sequenceFlow id="Flujo_8" sourceRef="P12_s1" targetRef="P12_f1"/>
    <bpmn:sequenceFlow id="Flujo_9" sourceRef="P12_s0" targetRef="P12_f2"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_P12">
    <bpmndi:BPMNPlane id="Plano_P12" bpmnElement="Colaboracion_P12">
      <bpmndi:BPMNShape id="Pool_P12_di" bpmnElement="Pool_P12" isHorizontal="true"><dc:Bounds x="20" y="20" width="1500" height="560"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_dir_di" bpmnElement="Carril_dir" isHorizontal="true"><dc:Bounds x="50" y="20" width="1470" height="145"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_pre_di" bpmnElement="Carril_pre" isHorizontal="true"><dc:Bounds x="50" y="165" width="1470" height="145"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_sis_di" bpmnElement="Carril_sis" isHorizontal="true"><dc:Bounds x="50" y="310" width="1470" height="270"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_i_di" bpmnElement="P12_i"><dc:Bounds x="162" y="74" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="105.0" y="114.5" width="150" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_d1_di" bpmnElement="P12_d1"><dc:Bounds x="290" y="52" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_d2_di" bpmnElement="P12_d2"><dc:Bounds x="460" y="52" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_p1_di" bpmnElement="P12_p1"><dc:Bounds x="630" y="198" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_g1_di" bpmnElement="P12_g1"><dc:Bounds x="835" y="212" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="795.0" y="178.5" width="130" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_s0_di" bpmnElement="P12_s0"><dc:Bounds x="970" y="342" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_t1_di" bpmnElement="P12_t1"><dc:Bounds x="1012" y="490" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="955.0" y="529.5" width="150" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_s1_di" bpmnElement="P12_s1"><dc:Bounds x="1140" y="468" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_f1_di" bpmnElement="P12_f1"><dc:Bounds x="1352" y="364" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1295.0" y="404.5" width="150" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_f2_di" bpmnElement="P12_f2"><dc:Bounds x="1182" y="364" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1125.0" y="404.5" width="150" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flujo_1_di" bpmnElement="Flujo_1"><di:waypoint x="198" y="92"/><di:waypoint x="290" y="92"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_2_di" bpmnElement="Flujo_2"><di:waypoint x="410" y="92"/><di:waypoint x="460" y="92"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_3_di" bpmnElement="Flujo_3"><di:waypoint x="580" y="92"/><di:waypoint x="605" y="92"/><di:waypoint x="605" y="238"/><di:waypoint x="630" y="238"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_4_di" bpmnElement="Flujo_4"><di:waypoint x="750" y="238"/><di:waypoint x="835" y="238"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_5_di" bpmnElement="Flujo_5"><di:waypoint x="860" y="262"/><di:waypoint x="860" y="508"/><di:waypoint x="1012" y="508"/><bpmndi:BPMNLabel><dc:Bounds x="872" y="490" width="30" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_6_di" bpmnElement="Flujo_6"><di:waypoint x="860" y="262"/><di:waypoint x="860" y="382"/><di:waypoint x="970" y="382"/><bpmndi:BPMNLabel><dc:Bounds x="874" y="364" width="30" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_7_di" bpmnElement="Flujo_7"><di:waypoint x="1048" y="508"/><di:waypoint x="1140" y="508"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_8_di" bpmnElement="Flujo_8"><di:waypoint x="1260" y="508"/><di:waypoint x="1327" y="508"/><di:waypoint x="1327" y="382"/><di:waypoint x="1352" y="382"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_9_di" bpmnElement="Flujo_9"><di:waypoint x="1090" y="382"/><di:waypoint x="1182" y="382"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

  <bpmn:collaboration id="Colaboracion_P02">
    <bpmn:documentation>P-02 Afiliación y registro de jugadores. Afiliar al club en la temporada y registrar a sus jugadores con identidad validada por CURP.</bpmn:documentation>
    <bpmn:participant id="Pool_P02" name="Liga Municipal de Futbol Amateur Morelia — SIGLIM" processRef="Proceso_P02"/>
  </bpmn:collaboration>
  <bpmn:process id="Proceso_P02" name="P-02 Afiliación y registro de jugadores" isExecutable="false">
    <bpmn:laneSet id="Carriles_P02"><bpmn:lane id="Carril_dir" name="Directiva de club"><bpmn:flowNodeRef>P02_i</bpmn:flowNodeRef><bpmn:flowNodeRef>P02_d1</bpmn:flowNodeRef><bpmn:flowNodeRef>P02_d0</bpmn:flowNodeRef><bpmn:flowNodeRef>P02_d2</bpmn:flowNodeRef><bpmn:flowNodeRef>P02_d3</bpmn:flowNodeRef><bpmn:flowNodeRef>P02_d4</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_sec" name="Secretario (liga)"><bpmn:flowNodeRef>P02_c1</bpmn:flowNodeRef><bpmn:flowNodeRef>P02_c2</bpmn:flowNodeRef><bpmn:flowNodeRef>P02_g2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_pre" name="Presidente del Comité Ejecutivo"><bpmn:flowNodeRef>P02_p1</bpmn:flowNodeRef><bpmn:flowNodeRef>P02_g0</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_sis" name="Sistema"><bpmn:flowNodeRef>P02_s0</bpmn:flowNodeRef><bpmn:flowNodeRef>P02_s1</bpmn:flowNodeRef><bpmn:flowNodeRef>P02_g1</bpmn:flowNodeRef><bpmn:flowNodeRef>P02_s2</bpmn:flowNodeRef><bpmn:flowNodeRef>P02_s3</bpmn:flowNodeRef><bpmn:flowNodeRef>P02_s4</bpmn:flowNodeRef><bpmn:flowNodeRef>P02_f1</bpmn:flowNodeRef><bpmn:flowNodeRef>P02_f2</bpmn:flowNodeRef><bpmn:flowNodeRef>P02_f3</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
        <bpmn:startEvent id="P02_i" name="Periodo de afiliación"><bpmn:outgoing>Flujo_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P02_d1" name="Capturar tarjetón y directiva"><bpmn:incoming>Flujo_1</bpmn:incoming><bpmn:outgoing>Flujo_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P02_s0" name="Asignar folio"><bpmn:incoming>Flujo_2</bpmn:incoming><bpmn:outgoing>Flujo_3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P02_c1" name="Revisar tarjetón"><bpmn:incoming>Flujo_3</bpmn:incoming><bpmn:incoming>Flujo_7</bpmn:incoming><bpmn:outgoing>Flujo_4</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P02_p1" name="Aprobar afiliación"><bpmn:incoming>Flujo_4</bpmn:incoming><bpmn:outgoing>Flujo_5</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P02_g0" name="¿Aprobada?"><bpmn:incoming>Flujo_5</bpmn:incoming><bpmn:outgoing>Flujo_6</bpmn:outgoing><bpmn:outgoing>Flujo_8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P02_d0" name="Corregir tarjetón"><bpmn:incoming>Flujo_6</bpmn:incoming><bpmn:outgoing>Flujo_7</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P02_d2" name="Registrar equipos"><bpmn:incoming>Flujo_8</bpmn:incoming><bpmn:outgoing>Flujo_9</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P02_d3" name="Capturar CURP del jugador"><bpmn:incoming>Flujo_9</bpmn:incoming><bpmn:outgoing>Flujo_10</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P02_s1" name="Validar unicidad de la CURP"><bpmn:incoming>Flujo_10</bpmn:incoming><bpmn:outgoing>Flujo_11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P02_g1" name="¿Registro activo en la temporada?"><bpmn:incoming>Flujo_11</bpmn:incoming><bpmn:outgoing>Flujo_12</bpmn:outgoing><bpmn:outgoing>Flujo_14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P02_s2" name="Rechazar e indicar club y equipo"><bpmn:incoming>Flujo_12</bpmn:incoming><bpmn:outgoing>Flujo_13</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P02_d4" name="Cargar documentos y consentimiento"><bpmn:incoming>Flujo_14</bpmn:incoming><bpmn:outgoing>Flujo_15</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P02_c2" name="Validar documentos e identidad"><bpmn:incoming>Flujo_15</bpmn:incoming><bpmn:outgoing>Flujo_16</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P02_g2" name="¿Válido?"><bpmn:incoming>Flujo_16</bpmn:incoming><bpmn:outgoing>Flujo_17</bpmn:outgoing><bpmn:outgoing>Flujo_18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P02_s3" name="Activar registro"><bpmn:incoming>Flujo_17</bpmn:incoming><bpmn:outgoing>Flujo_19</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P02_s4" name="Rechazar con observaciones"><bpmn:incoming>Flujo_18</bpmn:incoming><bpmn:outgoing>Flujo_20</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P02_f1" name="Registro activo"><bpmn:incoming>Flujo_19</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P02_f2" name="Registro rechazado"><bpmn:incoming>Flujo_20</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P02_f3" name="CURP duplicada"><bpmn:incoming>Flujo_13</bpmn:incoming></bpmn:endEvent>

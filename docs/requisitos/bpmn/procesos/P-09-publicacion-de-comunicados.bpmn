      <bpmndi:BPMNShape id="P09_g1_di" bpmnElement="P09_g1"><dc:Bounds x="835" y="212" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="795.0" y="178.5" width="130" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P09_s1_di" bpmnElement="P09_s1"><dc:Bounds x="970" y="342" width="120" height="80"/></bpmndi:BPMNShape>

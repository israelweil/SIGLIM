      <bpmndi:BPMNEdge id="Flujo_6_di" bpmnElement="Flujo_6"><di:waypoint x="860" y="262"/><di:waypoint x="860" y="382"/><di:waypoint x="970" y="382"/><bpmndi:BPMNLabel><dc:Bounds x="866" y="266" width="30" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_7_di" bpmnElement="Flujo_7"><di:waypoint x="1090" y="382"/><di:waypoint x="1182" y="382"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>

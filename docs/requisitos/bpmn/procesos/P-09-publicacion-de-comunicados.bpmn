      <bpmndi:BPMNEdge id="Flujo_1_di" bpmnElement="Flujo_1"><di:waypoint x="198" y="92"/><di:waypoint x="290" y="92"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_2_di" bpmnElement="Flujo_2"><di:waypoint x="410" y="92"/><di:waypoint x="460" y="92"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_3_di" bpmnElement="Flujo_3"><di:waypoint x="580" y="92"/><di:waypoint x="605" y="92"/><di:waypoint x="605" y="238"/><di:waypoint x="630" y="238"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_4_di" bpmnElement="Flujo_4"><di:waypoint x="750" y="238"/><di:waypoint x="835" y="238"/></bpmndi:BPMNEdge>

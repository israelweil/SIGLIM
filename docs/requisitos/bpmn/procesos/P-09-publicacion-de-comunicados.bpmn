<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definiciones_P09" targetNamespace="https://github.com/israelweil/SIGLIM/bpmn"
  exporter="SIGLIM generar_bpmn.py" exporterVersion="2.0">
  <bpmn:collaboration id="Colaboracion_P09">
    <bpmn:documentation>P-09 Publicación del portal (comunicados). Llevar los comunicados por el flujo Borrador → Revisión → Publicado.</bpmn:documentation>
    <bpmn:participant id="Pool_P09" name="Liga Municipal de Futbol Amateur Morelia — SIGLIM" processRef="Proceso_P09"/>
  </bpmn:collaboration>
  <bpmn:process id="Proceso_P09" name="P-09 Publicación del portal (comunicados)" isExecutable="false">
    <bpmn:laneSet id="Carriles_P09"><bpmn:lane id="Carril_sec" name="Secretario (liga)"><bpmn:flowNodeRef>P09_i</bpmn:flowNodeRef><bpmn:flowNodeRef>P09_t1</bpmn:flowNodeRef><bpmn:flowNodeRef>P09_t2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_pre" name="Presidente del Comité Ejecutivo"><bpmn:flowNodeRef>P09_p1</bpmn:flowNodeRef><bpmn:flowNodeRef>P09_g1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_sis" name="Sistema"><bpmn:flowNodeRef>P09_s1</bpmn:flowNodeRef><bpmn:flowNodeRef>P09_f1</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
        <bpmn:startEvent id="P09_i" name="Comunicado por difundir"><bpmn:outgoing>Flujo_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P09_t1" name="Redactar comunicado (Borrador)"><bpmn:incoming>Flujo_1</bpmn:incoming><bpmn:incoming>Flujo_5</bpmn:incoming><bpmn:outgoing>Flujo_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P09_t2" name="Enviar a revisión"><bpmn:incoming>Flujo_2</bpmn:incoming><bpmn:outgoing>Flujo_3</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P09_p1" name="Revisar comunicado"><bpmn:incoming>Flujo_3</bpmn:incoming><bpmn:outgoing>Flujo_4</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P09_g1" name="¿Aprueba?"><bpmn:incoming>Flujo_4</bpmn:incoming><bpmn:outgoing>Flujo_5</bpmn:outgoing><bpmn:outgoing>Flujo_6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P09_s1" name="Publicar en el portal"><bpmn:incoming>Flujo_6</bpmn:incoming><bpmn:outgoing>Flujo_7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P09_f1" name="Comunicado publicado"><bpmn:incoming>Flujo_7</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_1" sourceRef="P09_i" targetRef="P09_t1"/>
    <bpmn:sequenceFlow id="Flujo_2" sourceRef="P09_t1" targetRef="P09_t2"/>
    <bpmn:sequenceFlow id="Flujo_3" sourceRef="P09_t2" targetRef="P09_p1"/>
    <bpmn:sequenceFlow id="Flujo_4" sourceRef="P09_p1" targetRef="P09_g1"/>
    <bpmn:sequenceFlow id="Flujo_5" name="No, devuelve" sourceRef="P09_g1" targetRef="P09_t1"/>
    <bpmn:sequenceFlow id="Flujo_6" name="Sí" sourceRef="P09_g1" targetRef="P09_s1"/>
    <bpmn:sequenceFlow id="Flujo_7" sourceRef="P09_s1" targetRef="P09_f1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_P09">
    <bpmndi:BPMNPlane id="Plano_P09" bpmnElement="Colaboracion_P09">

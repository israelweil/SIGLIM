  <bpmn:collaboration id="Colaboracion_P04">
    <bpmn:documentation>P-04 Ciclo de vida del partido. Controlar los estados del partido con trazabilidad.</bpmn:documentation>
    <bpmn:participant id="Pool_P04" name="Liga Municipal de Futbol Amateur Morelia — SIGLIM" processRef="Proceso_P04"/>
  </bpmn:collaboration>
  <bpmn:process id="Proceso_P04" name="P-04 Ciclo de vida del partido" isExecutable="false">
    <bpmn:laneSet id="Carriles_P04"><bpmn:lane id="Carril_pro" name="Programador de partidos"><bpmn:flowNodeRef>P04_m1</bpmn:flowNodeRef><bpmn:flowNodeRef>P04_g0</bpmn:flowNodeRef><bpmn:flowNodeRef>P04_p0</bpmn:flowNodeRef><bpmn:flowNodeRef>P04_p1</bpmn:flowNodeRef><bpmn:flowNodeRef>P04_m3</bpmn:flowNodeRef><bpmn:flowNodeRef>P04_p2</bpmn:flowNodeRef><bpmn:flowNodeRef>P04_p3</bpmn:flowNodeRef><bpmn:flowNodeRef>P04_f2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carril_sis" name="Sistema"><bpmn:flowNodeRef>P04_i</bpmn:flowNodeRef><bpmn:flowNodeRef>P04_e1</bpmn:flowNodeRef><bpmn:flowNodeRef>P04_t0</bpmn:flowNodeRef><bpmn:flowNodeRef>P04_s1</bpmn:flowNodeRef><bpmn:flowNodeRef>P04_e2</bpmn:flowNodeRef><bpmn:flowNodeRef>P04_m2</bpmn:flowNodeRef><bpmn:flowNodeRef>P04_s2</bpmn:flowNodeRef><bpmn:flowNodeRef>P04_f1</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
        <bpmn:startEvent id="P04_i" name="Partido programado"><bpmn:outgoing>Flujo_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:eventBasedGateway id="P04_e1" name=""><bpmn:incoming>Flujo_1</bpmn:incoming><bpmn:incoming>Flujo_7</bpmn:incoming><bpmn:incoming>Flujo_17</bpmn:incoming><bpmn:outgoing>Flujo_2</bpmn:outgoing><bpmn:outgoing>Flujo_3</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="P04_m1" name="Reprogramación o cancelación solicitada"><bpmn:incoming>Flujo_3</bpmn:incoming><bpmn:outgoing>Flujo_4</bpmn:outgoing><bpmn:messageEventDefinition/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="P04_t0" name="Fecha y hora del partido"><bpmn:incoming>Flujo_2</bpmn:incoming><bpmn:outgoing>Flujo_9</bpmn:outgoing><bpmn:timerEventDefinition/></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="P04_g0" name="¿Tipo de cambio?"><bpmn:incoming>Flujo_4</bpmn:incoming><bpmn:outgoing>Flujo_5</bpmn:outgoing><bpmn:outgoing>Flujo_6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P04_p0" name="Reprogramar con motivo"><bpmn:incoming>Flujo_5</bpmn:incoming><bpmn:outgoing>Flujo_7</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P04_p1" name="Cancelar con motivo"><bpmn:incoming>Flujo_6</bpmn:incoming><bpmn:outgoing>Flujo_8</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P04_s1" name="Cambiar a En curso"><bpmn:incoming>Flujo_9</bpmn:incoming><bpmn:outgoing>Flujo_10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:eventBasedGateway id="P04_e2" name=""><bpmn:incoming>Flujo_10</bpmn:incoming><bpmn:outgoing>Flujo_11</bpmn:outgoing><bpmn:outgoing>Flujo_12</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="P04_m2" name="Cédula aprobada (P-05)"><bpmn:incoming>Flujo_11</bpmn:incoming><bpmn:outgoing>Flujo_13</bpmn:outgoing><bpmn:messageEventDefinition/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="P04_m3" name="Suspensión durante el juego"><bpmn:incoming>Flujo_12</bpmn:incoming><bpmn:outgoing>Flujo_15</bpmn:outgoing><bpmn:messageEventDefinition/></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="P04_p2" name="Suspender con motivo"><bpmn:incoming>Flujo_15</bpmn:incoming><bpmn:outgoing>Flujo_16</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P04_p3" name="Reprogramar partido suspendido"><bpmn:incoming>Flujo_16</bpmn:incoming><bpmn:outgoing>Flujo_17</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P04_s2" name="Cambiar a Finalizado"><bpmn:incoming>Flujo_13</bpmn:incoming><bpmn:outgoing>Flujo_14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P04_f1" name="Partido finalizado"><bpmn:incoming>Flujo_14</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P04_f2" name="Partido cancelado"><bpmn:incoming>Flujo_8</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_1" sourceRef="P04_i" targetRef="P04_e1"/>
